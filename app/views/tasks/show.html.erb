<h1><%= @task.title %></h1>
<hr>

<textarea readonly><%= @task.details %></textarea><br>
<input type="checkbox" <%= "checked" if @task.completed %>>

<% if @task.completed %>
  This task is completed
<% else %>
This task is not completed yet
<% end %>

<br><br>
<%= link_to 'Edit task', edit_task_path(@task.id)  %>
