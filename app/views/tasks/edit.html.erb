
<h1>Edit task</h1>

<%= form_with model: @task do |t| %>

  <%= t.label :title %>
  <%= t.text_field :title %>
  <br><br>

  <%= t.label :details %>
  <%= t.text_area :details %>
  <br><br>

  <%= t.check_box :completed %>

  <% if @task.completed %>
    This task is completed
  <% else %>
    This task is not completed
  <% end %>

  <br><br>

  <%= t.submit "Update task" %>

<% end %>

<br><br>

<%= link_to 'Back to list', tasks_path %>
